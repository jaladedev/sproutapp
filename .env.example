# Required
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional — display/link metadata
NEXT_PUBLIC_APP_NAME=SproutVest
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — defaults to 1440 (24h) if unset. Should match the API's JWT TTL.
NEXT_PUBLIC_JWT_TTL_MINUTES=1440

# Optional — R2/CDN base URL for land/blog images
NEXT_PUBLIC_R2_URL=

# Required for real-time features (admin live chat, notifications)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http